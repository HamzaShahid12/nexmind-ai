# Values to add/replace in the .env generated by Laravel. Never commit real secrets.

APP_NAME="NexMind AI"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexmind
DB_USERNAME=root
DB_PASSWORD=

# --- SPA cookie authentication (Sanctum) ---
# Frontend host(s) that may use cookie auth. Must share a registrable domain with the API.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DRIVER=database
SESSION_DOMAIN=localhost
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false   # set true under HTTPS in production

QUEUE_CONNECTION=database
MAIL_MAILER=log               # use smtp in production for verification / reset emails

# --- AI provider (backend only) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=2500

# --- Documents ---
DOC_MAX_KB=5120
DOC_RETENTION_DAYS=7

# --- Seeding (development only) ---
SEED_ADMIN_EMAIL=admin@nexmind.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
